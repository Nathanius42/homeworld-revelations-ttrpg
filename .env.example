# Copy to .env (git-ignored) and fill in. Never commit real values.

# Claude as the AI Game Master. Leave unset to use the scripted Director GM.
ANTHROPIC_API_KEY=

# The Claude GM model. Leave unset for claude-haiku-5-5 (cheapest); step up to claude-sonnet-5-5 or claude-opus-5-5 if needed.
HWR_GM_MODEL=

# Claude Code sessions can set ANTHROPIC_BASE_URL in your shell; the app server
# ignores it unless HWR_ANTHROPIC_BASE_URL is set here.
HWR_ANTHROPIC_BASE_URL=

# Server port (the web client is served from the same port in production).
PORT=8787
